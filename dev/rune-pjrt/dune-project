(lang dune 3.21)

(name rune-pjrt)

(package
 (name rune-pjrt)
 (synopsis "Experimental PJRT/XLA JIT backend for Rune")
 (description
  "Rune-pjrt is an experimental PJRT/XLA JIT backend for Rune. It traces Rune programs, lowers them to StableHLO, and executes them through PJRT on CPU and CUDA." )
 (depends
  (ocaml
   (>= 5.2.0))
  dune
  (dune-configurator :build)
  conf-python-3
  nx
  (ppx_rune_kernel :with-test)
  (tolk :with-test)))

(package
 (name ppx_rune_kernel)
 (synopsis "PPX syntax for experimental Rune PJRT CUDA kernels")
 (description
  "Ppx_rune_kernel provides normal staged-expression syntax and rewrites annotated Rune functions into PJRT CUDA custom calls with ordinary Rune fallbacks.")
 (depends
  (ocaml
   (>= 5.2.0))
  dune
  (ppxlib
   (>= 0.38.0))))
