(data_only_dirs data)

(executable
 (name bench_brot)
 (libraries brot thumper unix))

(rule
 (alias bench)
 (deps
  (source_tree data))
 (action
  (setenv
   RAVEN_BENCH_DATA_DIR
   %{workspace_root}/packages/brot/bench/data
   (progn
    (run %{exe:bench_brot.exe} -q)
    (diff? brot.thumper brot.thumper.corrected)))))
