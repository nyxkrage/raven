(executable
 (name bench_talon)
 (libraries talon talon.csv thumper))

(rule
 (alias bench)
 (deps
  (source_tree data))
 (action
  (setenv
   RAVEN_BENCH_DATA_DIR
   %{workspace_root}/packages/talon/bench/data
   (progn
    (run %{exe:bench_talon.exe} -q)
    (diff? talon.thumper talon.thumper.corrected)))))
