(executable
 (name bench_sowilo)
 (libraries sowilo nx.io nx thumper))

(rule
 (alias bench)
 (deps
  (source_tree data))
 (action
  (setenv
   RAVEN_BENCH_DATA_DIR
   %{workspace_root}/packages/sowilo/bench/data
   (progn
    (run %{exe:bench_sowilo.exe} -q)
    (diff? sowilo.thumper sowilo.thumper.corrected)))))
